generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                String             @id @default(uuid())
  sku               String             @unique
  name              String
  motif             String?
  color             String?
  costPrice         Int                @default(0) @map("cost_price")
  sellingPrice      Int                @default(0) @map("selling_price")
  wholesalePrice    Int                @default(0) @map("wholesale_price")
  physicalStock     Int                @default(0) @map("physical_stock")
  reservedStock     Int                @default(0) @map("reserved_stock")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  stockTransactions StockTransaction[]
  orderItems        OrderItem[]

  @@map("products")
}

model StockTransaction {
  id              String   @id @default(uuid())
  productId       String   @map("product_id")
  type            String
  quantity        Int
  transactionDate DateTime @default(now()) @map("transaction_date")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_transactions")
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique @map("order_number")
  customerName  String      @map("customer_name")
  customerPhone String?     @map("customer_phone")
  status        String      @default("HOLD") // HOLD, PAID, SHIPPED, CANCELLED
  totalAmount   Int         @default(0) @map("total_amount")
  notes         String?
  paidAt        DateTime?   @map("paid_at")
  shippedAt     DateTime?   @map("shipped_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  items         OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  productId   String?  @map("product_id")
  productSku  String   @map("product_sku")
  productName String   @map("product_name")
  costPrice   Int      @default(0) @map("cost_price")
  price       Int      @default(0)
  quantity    Int      @default(1)
  subtotal    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model ZiplockStock {
  id          String   @id @default(uuid())
  name        String   @default("Ziplock Packaging")
  stock       Int      @default(0)
  unitCost    Int      @default(700) @map("unit_cost")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("ziplock_stocks")
}

model MotifAsset {
  id             String   @id @default(uuid())
  motifName      String   @unique @map("motif_name")
  purchaseCost   Int      @default(0) @map("purchase_cost")
  purchaseDate   DateTime @default(now()) @map("purchase_date")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("motif_assets")
}

model FinanceTransaction {
  id              String   @id @default(uuid())
  type            String   // INCOME, EXPENSE
  category        String   // ONG_KIR_RESTOK, ZIPLOCK, MOTIF, SALARY, SALES, OPERATIONAL, OTHER
  amount          Int      @default(0)
  description     String
  transactionDate DateTime @default(now()) @map("transaction_date")
  referenceId     String?  @map("reference_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("finance_transactions")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  name      String
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

