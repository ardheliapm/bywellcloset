generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id                String             @id @default(uuid())
  sku               String             @unique
  name              String
  motif             String?
  color             String?
  costPrice         Int                @default(0) @map("cost_price")
  sellingPrice      Int                @default(0) @map("selling_price")
  wholesalePrice    Int                @default(0) @map("wholesale_price")
  physicalStock     Int                @default(0) @map("physical_stock")
  reservedStock     Int                @default(0) @map("reserved_stock")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  stockTransactions StockTransaction[]
  orderItems        OrderItem[]
  preOrderItems     PreOrderItem[]
  inboundShipmentItems InboundShipmentItem[]

  @@map("products")
}

model StockTransaction {
  id              String   @id @default(uuid())
  productId       String   @map("product_id")
  type            String
  quantity        Int
  transactionDate DateTime @default(now()) @map("transaction_date")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_transactions")
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique @map("order_number")
  customerName  String      @map("customer_name")
  customerPhone String?     @map("customer_phone")
  status        String      @default("HOLD") // HOLD, PAID, SHIPPED, CANCELLED
  totalAmount   Int         @default(0) @map("total_amount")
  notes         String?
  paidAt        DateTime?   @map("paid_at")
  shippedAt     DateTime?   @map("shipped_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  items         OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  productId   String?  @map("product_id")
  productSku  String   @map("product_sku")
  productName String   @map("product_name")
  costPrice   Int      @default(0) @map("cost_price")
  price       Int      @default(0)
  quantity    Int      @default(1)
  subtotal    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model PreOrder {
  id            String         @id @default(uuid())
  poNumber      String         @unique @map("po_number")
  customerName  String         @map("customer_name")
  customerPhone String?        @map("customer_phone")
  status        String         @default("WAITING_STOCK") // WAITING_STOCK, PARTIAL_READY, READY, PARTIAL_SHIPPED, SHIPPED, CANCELLED
  totalAmount   Int            @default(0) @map("total_amount")
  notes         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  items         PreOrderItem[]

  @@map("pre_orders")
}

model PreOrderItem {
  id                String    @id @default(uuid())
  preOrderId        String    @map("pre_order_id")
  productId         String?   @map("product_id")
  productSku        String    @map("product_sku")
  productName       String    @map("product_name")
  price             Int       @default(0)
  quantityOrdered   Int       @default(1) @map("quantity_ordered")
  quantityFulfilled Int       @default(0) @map("quantity_fulfilled")
  quantityShipped   Int       @default(0) @map("quantity_shipped")
  subtotal          Int       @default(0)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  preOrder          PreOrder  @relation(fields: [preOrderId], references: [id], onDelete: Cascade)
  product           Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("pre_order_items")
}

model ZiplockStock {
  id          String   @id @default(uuid())
  name        String   @default("Ziplock Packaging")
  stock       Int      @default(0)
  unitCost    Int      @default(700) @map("unit_cost")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("ziplock_stocks")
}

model MotifAsset {
  id             String   @id @default(uuid())
  motifName      String   @unique @map("motif_name")
  purchaseCost   Int      @default(0) @map("purchase_cost")
  purchaseDate   DateTime @default(now()) @map("purchase_date")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("motif_assets")
}

model FinanceTransaction {
  id              String   @id @default(uuid())
  type            String   // INCOME, EXPENSE
  category        String   // ONG_KIR_RESTOK, ZIPLOCK, MOTIF, SALARY, SALES, OPERATIONAL, OTHER
  amount          Int      @default(0)
  description     String
  transactionDate DateTime @default(now()) @map("transaction_date")
  referenceId     String?  @map("reference_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("finance_transactions")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  name      String
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model InboundShipment {
  id               String                @id @default(uuid())
  invoiceNumber    String                @unique @map("invoice_number")
  supplierName     String?               @default("Konveksi / Gudang") @map("supplier_name")
  status           String                @default("ON_DELIVERY") // ON_DELIVERY, RECEIVED, CANCELLED
  totalExpectedPcs Int                   @default(0) @map("total_expected_pcs")
  totalReceivedPcs Int                   @default(0) @map("total_received_pcs")
  freightCost      Int                   @default(0) @map("freight_cost")
  expectedDate     DateTime?             @map("expected_date")
  receivedDate     DateTime?             @map("received_date")
  attachmentUrl    String?               @map("attachment_url")
  attachmentType   String?               @map("attachment_type") // IMAGE, PDF
  notes            String?
  auditNotes       String?               @map("audit_notes")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  items            InboundShipmentItem[]

  @@map("inbound_shipments")
}

model InboundShipmentItem {
  id          String          @id @default(uuid())
  shipmentId  String          @map("shipment_id")
  productId   String?         @map("product_id")
  productSku  String          @map("product_sku")
  productName String          @map("product_name")
  expectedQty Int             @default(0) @map("expected_qty")
  receivedQty Int             @default(0) @map("received_qty")
  notes       String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  shipment    InboundShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("inbound_shipment_items")
}

